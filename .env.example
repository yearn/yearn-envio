# Envio indexer access
ENVIO_GRAPHQL_URL=http://localhost:8080/v1/graphql
# JWT token for Bearer auth to the Envio GraphQL endpoint
ENVIO_PASSWORD=

# Core Envio runtime config
ENVIO_PG_SSL_MODE=false
HASURA_GRAPHQL_ROLE=admin
ENVIO_THROTTLE_CHAIN_METADATA_INTERVAL_MILLIS=500
ENVIO_THROTTLE_PRUNE_STALE_DATA_INTERVAL_MILLIS=30000
ENVIO_THROTTLE_LIVE_METRICS_BENCHMARK_INTERVAL_MILLIS=1000
ENVIO_THROTTLE_JSON_FILE_BENCHMARK_INTERVAL_MILLIS=500

# RPC selection (choose one)
# Global override (highest priority)
ENVIO_RPC_URL=

# Chain-specific RPCs (used when --chain is provided)
ENVIO_RPC_URL_ETHEREUM=
ENVIO_RPC_URL_OPTIMISM=
ENVIO_RPC_URL_GNOSIS=
ENVIO_RPC_URL_BASE=
ENVIO_RPC_URL_ARBITRUM=
ENVIO_RPC_URL_POLYGON=
ENVIO_RPC_URL_BERACHAIN=
ENVIO_RPC_URL_KATANA=

# Vault Allocation History (Ethereum only for the first production candidate)
# Archive failures create queryable gaps and do not stop unrelated indexing.
ENVIO_ALLOCATION_ARCHIVE_RPC_URL_ETHEREUM=

# Required only by explicit Gate 4 publication and candidate parity commands.
ENVIO_ALLOCATION_GRAPHQL_URL=
ENVIO_ALLOCATION_GRAPHQL_TOKEN=
ENVIO_ALLOCATION_SYNC_BLOCK_TOLERANCE=20
