  "mutationPaths": [
    {
      "name": "deposit-or-mint",
      "functions": ["_deposit", "_mint"],
      "writes": ["total_idle"],
      "terminalTriggers": ["Deposit"]
    },
    {
      "name": "withdraw-or-redeem",
      "functions": ["_redeem"],
      "writes": ["total_idle", "total_debt"],
      "terminalTriggers": ["Withdraw"],
      "additionalTriggers": ["DebtUpdated"]
    },
    {
      "name": "forced-strategy-revocation",
      "functions": ["_revoke_strategy"],
      "writes": ["total_debt"],
      "terminalTriggers": ["StrategyReported"]
    },
    {
      "name": "strategy-debt-update",
      "functions": ["_update_debt"],
      "writes": ["total_idle", "total_debt"],
      "terminalTriggers": ["DebtUpdated"]
    },
    {
      "name": "strategy-report",
      "functions": ["_process_report"],
      "writes": ["total_idle", "total_debt"],
      "terminalTriggers": ["StrategyReported"]
    },
    {
      "name": "debt-purchase",
      "functions": ["buy_debt"],
      "writes": ["total_idle", "total_debt"],
      "terminalTriggers": ["DebtUpdated"]
    }
  ],
  "excludedState": [
    {
      "name": "unrealized-asset-transfer",
      "reason": "Direct ERC20 transfers do not mutate total_idle or total_debt until a covered report path accounts for them."
    },
    {
      "name": "initialization",
      "reason": "Initialization leaves total_idle and total_debt at zero before the vault can emit accounting activity."
    }
  ]
