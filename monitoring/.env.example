# Envio cloud GraphQL (preferred). Same vars as the fee calculator / root .env.
# Built-in default when unset: https://indexer.hyperindex.xyz/3fec0a4/v1/graphql
# ENVIO_GRAPHQL_URL=https://indexer.hyperindex.xyz/3fec0a4/v1/graphql
# Bearer token for the cloud GraphQL endpoint (Authorization: Bearer <token>)
ENVIO_PASSWORD=

# Legacy self-hosted / Render aliases (used only when the cloud vars above are unset)
# GRAPHQL_URL=https://envio-gql.yearn.dev/v1/graphql
# GRAPHQL_HOST=           # bare hostname → http://$GRAPHQL_HOST:8080/v1/graphql
# GRAPHQL_BEARER_TOKEN=
# HASURA_GRAPHQL_JWT=

# Path to the envio indexer project on disk (reads envio version from package.json).
# Default ".." = repo root when this package lives at monitoring/.
INDEXER_PROJECT_PATH=..

# Port the dashboard server listens on
PORT=4100

# Per-chain RPC URLs for live chain-head lookup (eth_blockNumber). Without
# these, open-ended chains report status "unknown" rather than trusting
# envio metadata. Same names as the indexer; RPC_URL_<chainId> also accepted.
ENVIO_RPC_URL_ETHEREUM=
ENVIO_RPC_URL_OPTIMISM=
ENVIO_RPC_URL_GNOSIS=
ENVIO_RPC_URL_POLYGON=
ENVIO_RPC_URL_BASE=
ENVIO_RPC_URL_ARBITRUM=
ENVIO_RPC_URL_BERACHAIN=
ENVIO_RPC_URL_KATANA=
ENVIO_RPC_URL_HYPEREVM=
ENVIO_RPC_URL_ROBINHOOD=

# A chain is considered caught up only when its latest processed block is no
# more than this many blocks below its live RPC head (or explicit end block).
# Set to 0 for exact-block readiness. Defaults to 2 when unset/invalid.
SYNC_BLOCK_TOLERANCE=2

# Max age (in days) of the newest deposit/withdraw event for the canary vaults
# checked by /healthz before it reports "not ok". Defaults to 30 when unset/invalid.
HEALTH_MAX_DATA_AGE_DAYS=
