{
  "name": "envio-indexer",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean": "tsc --clean",
    "build": "tsc --build",
    "allocation:audit:gate3:runtimes": "node allocation/scripts/audit-gate3-vault-runtimes.mjs",
    "allocation:benchmark:gate3:rpc": "tsx allocation/scripts/benchmark-gate3-checkpoints.ts",
    "allocation:coverage:build-draft": "tsx allocation/scripts/build-gate4-draft-manifest.ts",
    "allocation:coverage:check": "tsx allocation/scripts/generate-gate4-coverage.ts --check",
    "allocation:coverage:generate": "tsx allocation/scripts/generate-gate4-coverage.ts",
    "allocation:coverage:publish": "tsx allocation/scripts/publish-gate4-coverage.ts",
    "allocation:fixtures:capture:gate4": "tsx allocation/scripts/capture-gate4-fixtures.ts",
    "allocation:monitor:gate4": "tsx allocation/scripts/monitor-gate4-candidate.ts",
    "allocation:parity:gate4": "tsx allocation/scripts/verify-gate4-parity.ts",
    "allocation:test": "vitest run allocation/test",
    "allocation:verify:gate2:rpc": "node allocation/scripts/verify-gate2-fixture.mjs",
    "allocation:verify:gate3:rpc": "tsx allocation/scripts/verify-gate3-checkpoints.ts",
    "watch": "tsc --watch",
    "mocha": "vitest run",
    "codegen": "envio codegen",
    "dev": "envio dev",
    "migrate": "envio local db-migrate up",
    "start": "envio start",
    "start:envio": "envio start",
    "sync:vaults": "node scripts/update_kong_vaults.js",
    "test": "vitest run",
    "calc-fees": "tsc -p tsconfig.calc.json && node build/calc/calculate-depositor-fees.js",
    "jwt:generate": "node scripts/generate_hasura_jwt.js"
  },
  "devDependencies": {
    "@types/node": "20.17.0",
    "dotenv": "17.4.1",
    "postgres": "3.4.9",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "dependencies": {
    "envio": "3.6.1",
    "viem": "2.47.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
